ai.self.test {
    tls internal
    reverse_proxy openwebui:8080
}

nextcloud.self.test {
    tls internal

    root * /var/www/html

    # Block direct access to user data directory
    # (NextCloud's .htaccess isn't read by Caddy)
    handle /data/* {
        respond 403
    }

    redir /.well-known/carddav /remote.php/dav/ 301
    redir /.well-known/caldav /remote.php/dav/ 301

    # Static files served directly from shared bind mount.
    # PHP requests proxied to nextcloud:9000 via FastCGI.
    php_fastcgi nextcloud:9000 {
        root /var/www/html
        env HTTPS on

        read_timeout  300s
        write_timeout 300s
    }

    file_server

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "no-referrer-when-downgrade"
    }

    encode gzip zstd

    log {
        output stdout
        format console
    }
}

